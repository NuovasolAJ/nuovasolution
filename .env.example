# NuovaSolution website. NAMES ONLY. Never commit a file with values.
# Every integration is disabled unless its variables are set.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_ENV=

# ---- Integration mode ----
# "stub" (default when unset): every contract call is answered locally by a
#   clearly labelled stub. No network request leaves the server.
# "staging": the BFF proxies to NUOVA_API_BASE. Only after the owner delivers
#   governance/WEBSITE_HANDOFF_v1.md and the independent review has passed.
#   Production targets are never permitted.
NUOVA_INTEGRATION_MODE=stub

# ---- Backend contract targets (server only) ----
NUOVA_API_BASE=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Browser-safe (only what the browser genuinely needs) ----
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ---- Q&A widget (server only). Absent means the widget renders its honest "cannot confirm" state. ----
QA_INTAKE_URL=
QA_TENANT_ID=
QA_TENANT_HMAC_SECRET=

# ---- Legal ----
# The legal routes always exist and are labelled PLACEHOLDER. Linking them from the
# public footer is a separate owner decision: set to "approved" only once made.
NEXT_PUBLIC_LEGAL_LINKS=

# ---- Contact ----
# The public WhatsApp CTA renders only when a number is set (E.164, no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CAL_URL=https://cal.com/nuovasolution/demo

# ---- Server only. NEVER prefixed NEXT_PUBLIC_. ----
SUPABASE_SERVICE_ROLE_KEY=
CAPTCHA_SECRET_KEY=
NUOVA_BFF_ALLOWED_ORIGIN=
