# NuovaSolution website. NAMES ONLY. Never commit a file with values.
# Every integration is disabled unless its variables are set.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_ENV=

# ---- Integration mode (read at BUILD time, see lib/contracts/mode.ts) ----
# stub     default. Every contract call answered locally by a labelled stub. Nothing leaves the server.
#          Stub account surfaces refuse in a public production deployment (VERCEL_ENV=production).
# staging  sandbox. The server talks to ONE pinned staging Supabase project only.
#          NUOVA_STAGING_TARGET_APPROVED must name that project ref (owner per-target approval,
#          MASTER_GOVERNANCE §14.5). Any other target is refused at runtime.
# live     production. The build is refused unless NUOVA_LIVE_RELEASE carries the owner's release value.
NUOVA_INTEGRATION_MODE=stub
NUOVA_STAGING_TARGET_APPROVED=
NUOVA_LIVE_RELEASE=

# ---- Backend (server only; the browser never talks to Supabase) ----
SUPABASE_URL=
# Publishable key: used server-side for the password grant and to verify sessions.
SUPABASE_ANON_KEY=
# Service-role / secret key: server only, used for the service-role RPCs the BFF wraps.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Browser-safe (only what the browser genuinely needs) ----
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ---- Q&A widget (server only). Absent means the widget renders its honest "cannot confirm" state. ----
# Outside a live build the intake may never be a production or retired host.
QA_INTAKE_URL=
QA_TENANT_ID=
QA_TENANT_HMAC_SECRET=

# ---- Legal ----
# The legal routes always exist and are labelled PLACEHOLDER. Linking them from the public
# footer and listing them in the sitemap is a separate owner decision: "approved" only once made.
NEXT_PUBLIC_LEGAL_LINKS=

# ---- Contact ----
# The public WhatsApp CTA renders only when a number is set (E.164, no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CAL_URL=https://cal.com/nuovasolution/demo

# ---- Server only. NEVER prefixed NEXT_PUBLIC_. ----
CAPTCHA_SECRET_KEY=
NUOVA_BFF_ALLOWED_ORIGIN=
